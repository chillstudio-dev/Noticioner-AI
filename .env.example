# Copy to .env.local. Add keys locally, never in chat or a video.
# Leave blank to auto-select Claude when ANTHROPIC_API_KEY exists, otherwise OpenAI.
AI_PROVIDER=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# Only required for an Anthropic key that is not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=

# Alternative note provider, or fallback audio transcription credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Optional audio provider. Pasted transcripts need no audio engine.
STT_PROVIDER=openai
# For key-free local audio: install whisper.cpp + FFmpeg and run npm run setup:transcription.
# Then set STT_PROVIDER=local. Optional paths override command discovery.
LOCAL_WHISPER_MODEL=./data/models/ggml-base.en.bin
LOCAL_WHISPER_BIN=whisper-cli
FFMPEG_BIN=ffmpeg
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
DATABASE_PATH=./data/cliniscribe.sqlite
