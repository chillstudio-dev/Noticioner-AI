{
  "name": "noticioner-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --disable-source-maps --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:init": "tsx scripts/init.ts",
    "setup:transcription": "node scripts/setup-transcription.mjs",
    "evaluate": "tsx scripts/evaluate.ts",
    "evaluate:trust": "node --import tsx scripts/evaluate-trust-deterministic.ts",
    "evaluate:12-case": "node scripts/validate-12-case-evaluation.mjs && node --import tsx scripts/evaluate-12-case-baseline-v1.ts && node scripts/score-12-case.mjs --run=evaluation-results/noticioner-12-baseline-v1.json --output=evaluation-results/noticioner-12-baseline-score.json && node --import tsx scripts/evaluate-12-case.ts --output=evaluation-results/noticioner-12-final.json && node scripts/score-12-case.mjs --run=evaluation-results/noticioner-12-final.json --output=evaluation-results/noticioner-12-final-score.json",
    "test:http": "node --test tests/http.test.mjs",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json",
    "test:server": "node scripts/check-server.mjs",
    "practice:migrate": "tsx scripts/practice-migrate.ts",
    "practice:provision": "tsx scripts/practice-provision.ts",
    "test:practice": "node scripts/practice-test.mjs",
    "demo:server": "tsx scripts/demo-server.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "jose": "^6.2.17",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "engines": {
    "node": ">=24.8.0"
  }
}
